# Bindings for the double-precision CBLAS/LAPACKE subset koblas dispatches to, declared directly
# rather than parsed from headers: there is no canonical header location across distributions, the
# prototypes below are frozen ABI, and this keeps the dev-package requirement to link time only.
# Enum parameters (CBLAS_ORDER and friends) are declared int, which is their C ABI. All integer
# widths are LP64 (32-bit lapack_int) — link the default OpenBLAS, not an INTERFACE64/openblas64
# build.
package = com.eignex.koblas.cblas.capi

# Debian/Ubuntu ship OpenBLAS without the LAPACKE C interface; it comes from the separate
# liblapacke package and dispatches to the active LAPACK alternative. Homebrew's OpenBLAS
# bundles LAPACKE, so macOS links libopenblas alone.
linkerOpts.linux = -L/usr/lib/x86_64-linux-gnu -L/usr/lib/aarch64-linux-gnu -L/usr/lib64 -llapacke -lopenblas
linkerOpts.osx = -L/opt/homebrew/opt/openblas/lib -L/usr/local/opt/openblas/lib -lopenblas

---

void openblas_set_num_threads(int num_threads);

void cblas_dscal(int n, double alpha, double *x, int incx);
void cblas_daxpy(int n, double alpha, const double *x, int incx, double *y, int incy);
void cblas_dgemv(int order, int transa, int m, int n, double alpha, const double *a, int lda,
                 const double *x, int incx, double beta, double *y, int incy);
void cblas_dgemm(int order, int transa, int transb, int m, int n, int k, double alpha,
                 const double *a, int lda, const double *b, int ldb, double beta,
                 double *c, int ldc);
void cblas_dsyrk(int order, int uplo, int trans, int n, int k, double alpha,
                 const double *a, int lda, double beta, double *c, int ldc);
void cblas_dsymv(int order, int uplo, int n, double alpha, const double *a, int lda,
                 const double *x, int incx, double beta, double *y, int incy);
void cblas_dsymm(int order, int side, int uplo, int m, int n, double alpha,
                 const double *a, int lda, const double *b, int ldb, double beta,
                 double *c, int ldc);
void cblas_dtrsv(int order, int uplo, int transa, int diag, int n,
                 const double *a, int lda, double *x, int incx);

int LAPACKE_dgetrf(int matrix_layout, int m, int n, double *a, int lda, int *ipiv);
int LAPACKE_dgecon(int matrix_layout, char norm, int n, const double *a, int lda,
                   double anorm, double *rcond);
int LAPACKE_dgeqrf(int matrix_layout, int m, int n, double *a, int lda, double *tau);
int LAPACKE_dormqr(int matrix_layout, char side, char trans, int m, int n, int k,
                   const double *a, int lda, const double *tau, double *c, int ldc);
int LAPACKE_dsytrf(int matrix_layout, char uplo, int n, double *a, int lda, int *ipiv);
int LAPACKE_dsytrs(int matrix_layout, char uplo, int n, int nrhs, const double *a, int lda,
                   const int *ipiv, double *b, int ldb);
